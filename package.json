{
  "name": "trixia",
  "version": "1.0.0",
  "description": "TRIXIA adalah storefront top up game berbasis React, Node.js, dan PostgreSQL.",
  "license": "ISC",
  "author": "trixia",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "api": "node --watch server/index.js",
    "test": "node --test server/tests/*.test.js",
    "db:migrate": "node-pg-migrate up -m server/migrations",
    "db:rollback": "node-pg-migrate down -m server/migrations",
    "db:create-migration": "node-pg-migrate create -m server/migrations",
    "lint": "eslint server",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.3.1",
    "vite": "^6.1.0"
  }
}
